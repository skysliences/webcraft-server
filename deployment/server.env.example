# Copy to server.env. Game operators connect to the shared core account service.
# These example domains must be replaced before production startup.
# Open the website's server-downloads.html, then its core account center.
# Register a server using the shared website and YOUR Go callback URL.
# Copy the five AUTH_*/GAME_PUBLIC_URL values returned by that registration.
ACCOUNT_MODE=central
AUTH_ISSUER_URL=https://login.ccraft.app
AUTH_PUBLIC_KEY=
AUTH_SERVER_ID=
GAME_PUBLIC_URL=https://play.example.com
AUTH_CALLBACK_URL=https://private.example.com/api/auth/callback
AUTH_COOKIE_SECURE=true
# Exact origin of the shared client website. Comma-separate explicit origins.
# Do not use your private Go address or a wildcard here.
ALLOWED_ORIGINS=https://play.example.com

# Private hosts run Go only. Nginx exposes this server's API and WebSocket.
# With Nginx on the same machine, keep Go on loopback and expose HTTPS 443.
# If a separate trusted TLS proxy needs to reach Go, bind the intended LAN
# interface (or 0.0.0.0) and restrict its port to that proxy.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8081
MAX_PLAYERS=64
# Natural category caps scale by unique loaded player chunks / 289.
MOB_MONSTER_LIMIT=70
MOB_ANIMAL_LIMIT=10
MOB_SPAWN_RANGE=8
# Minecraft ticks (20 ticks/second); the current Go host simulates at 10 Hz.
MOB_MONSTER_INTERVAL=1
MOB_ANIMAL_INTERVAL=400
MOB_SPAWN_ATTEMPTS=0
MOB_SPAWNS_PER_TICK=0
# Separate safety limit for all mob sources per dimension (1..4096).
MOB_TOTAL_LIMIT=1024
MOB_GENERATE_CHUNK_ANIMALS=true
PLUGIN_TIMEOUT=100ms
CONSOLE_ENABLED=true

# Optional shared website deployment only: not required on private game hosts.
# All players visit this one website, whose account proxy has a fixed core target.
# HOST=127.0.0.1
# PORT=8080
# CLIENT_PUBLIC_URL=https://play.example.com
# IDENTITY_PUBLIC_URL=https://login.ccraft.app
# IDENTITY_PROXY_URL=https://login.ccraft.app
# FRONTEND_TRUSTED_PROXIES=127.0.0.1
# API_URL=https://private.example.com
# DISCOVERY_API_URL=http://127.0.0.1:8081

# New installation: leave WORLD_ID blank; one world is generated and persisted.
# Existing installation: preserve data/ and its world-server.json binding.
WORLD_ID=
WORLD_NAME='世界'
WORLD_MODE=survival
INFINITE_WORLDS=true
LEGACY_MULTI_WORLD=false
# DATA_DIR=/absolute/path/to/data

# Same-computer central testing may use http://127.0.0.1 or localhost for
# issuer, client and callback (include each actual port); use
# AUTH_COOKIE_SECURE=false. Non-loopback central URLs require trusted HTTPS,
# including LAN IPs: http://192.168.x.x callbacks cannot be registered.
# Explicit development-only option: ACCOUNT_MODE=legacy and AUTH_ISSUER_URL=
# allows old per-server test accounts. Production uses the shared core identity.
