# Copy to account.env. This config belongs to the independent account service.
# Replace both example domains before starting. Public deployment uses HTTPS.
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=8082
IDENTITY_PUBLIC_URL=https://login.ccraft.app
IDENTITY_GAME_HOME_URL=https://play.example.com
AUTH_COOKIE_SECURE=true
IDENTITY_ALLOW_LEGACY_COOKIE=false

# Empty uses ./data and ./account-plugins beside account-start.sh.
IDENTITY_DATA_DIR=
IDENTITY_PLUGIN_DIR=

# First start: leave empty, register a normal account on the account website.
# Stop gracefully, set an existing fixed account ID (preferred) or username,
# then restart. The resolved IDs persist in data/admins.json, separate from OP.
# Multiple administrators are comma-separated. Never set an unregistered name.
IDENTITY_ADMIN_USERS=

# Trust only the actual reverse proxy. Nginx on this host uses these loopbacks.
# Keep empty when serving directly; never trust all IPs (0.0.0.0/0 or ::/0).
IDENTITY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional migration, only after stopping the process that owns the source:
# IDENTITY_IMPORT_FILE=/absolute/path/to/old/accounts.json
